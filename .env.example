# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git, so your keys never reach GitHub.
# Add the same four values in Vercel: Project > Settings > Environment Variables.

# Supabase: Project Settings > Data API (URL) and API Keys (secret key, starts with sb_secret_)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Anthropic Console: Settings > API Keys (starts with sk-ant-)
ANTHROPIC_API_KEY=

# A long random password you make up. Clay must send it in the x-api-secret header.
LEADS_API_SECRET=
