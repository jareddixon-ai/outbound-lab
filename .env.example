# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git, so your keys never reach GitHub.
# Add the same four values in Vercel: Project > Settings > Environment Variables.

# Supabase: Project Settings > Data API (URL) and API Keys (secret key, starts with sb_secret_)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Anthropic Console: Settings > API Keys (starts with sk-ant-)
ANTHROPIC_API_KEY=

# A long random password you make up. Clay must send it in the x-api-secret header.
LEADS_API_SECRET=

# Salesforce (Part B, step 5). Leave empty to skip the Salesforce step.
# SF_LOGIN_URL is your org's My Domain URL: Setup > My Domain, e.g. https://yourname-dev-ed.develop.my.salesforce.com
SF_LOGIN_URL=
# From the External Client App's OAuth settings: Consumer Key and Consumer Secret
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# --- v2 ---
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" to /api/worker.
# Make up another long random value.
CRON_SECRET=

# Instantly (optional; leave empty to skip the hand-off).
# Settings > Integrations > API Keys. Give it the leads:create scope.
INSTANTLY_API_KEY=
# The campaign's id: open the campaign; it's the long id in the address bar.
INSTANTLY_CAMPAIGN_ID=
# Another made-up value. Add it as the x-webhook-secret header on the Instantly webhook.
INSTANTLY_WEBHOOK_SECRET=
